{
    "manifest_version": 3,
    "name": "CodePlay Helper",
    "version": "1.0",
    "description": "Helper extension for CodePlay Editor to sync LeetCode cookies.",
    "permissions": [
        "cookies",
        "activeTab",
        "scripting",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "https://leetcode.com/*",
        "https://codeforces.com/*",
        "https://cses.fi/*",
        "https://code-editor-phi-two.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://code-editor-phi-two.vercel.app/*",
                "http://localhost/*",
                "http://127.0.0.1/*",
                "http://localhost:5173/*",
                "http://127.0.0.1:5173/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "action": {
        "default_popup": "popup.html"
    }
}